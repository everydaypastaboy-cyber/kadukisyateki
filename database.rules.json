{
  "rules": {
    "records": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'ここに受付用アカウントのUIDを貼る'",
      "$id": {
        ".validate": "newData.hasChildren(['name', 'score', 'at'])",
        "name":  { ".validate": "newData.isString() && newData.val().length <= 16" },
        "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999" },
        "at":    { ".validate": "newData.isNumber()" },
        "anon":  { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "private": {
      ".read": "auth != null && auth.uid === 'ここに受付用アカウントのUIDを貼る'",
      ".write": "auth != null && auth.uid === 'ここに受付用アカウントのUIDを貼る'",
      "$id": {
        "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "$other": { ".validate": false }
      }
    }
  }
}
